PROTON_USERNAME=your@protonmail.com
PROTON_PASSWORD=your-bridge-app-password
PROTON_BRIDGE_HOST=127.0.0.1
PROTON_BRIDGE_IMAP_PORT=1143
PROTON_BRIDGE_SMTP_PORT=1025
# Set to "streamable-http" for LibreChat Docker deployment; default is "stdio" for Claude Code
MCP_TRANSPORT=stdio
MCP_HOST=0.0.0.0
MCP_PORT=3004

# --- Diagnostics scripts only (.claude/skills/proton-mcp-diagnostics-and-tooling) ---
# Not read by proton_email_server.py itself. These give the read-only
# connectivity/drift/stack-health scripts a real target without ever
# committing your actual LAN host or SSH alias to the repo. Copy this file to
# a repo-root .env (gitignored) and fill in your own values; every script
# defaults to loopback (127.0.0.1) when unset, which is safe but inert.
PROTON_MCP_HOST=127.0.0.1
PROTON_MCP_SSH_HOST=your-desktop-ssh-alias
